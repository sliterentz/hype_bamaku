# Environment Configuration
ENVIRONMENT=development
MOCK_MODE=true

# Hyper-V VM Specs (per-node)
HYPERV_NODE_COUNT=2
HYPERV_CPUS=4
HYPERV_MEMORY_GB=8
HYPERV_DISK_GB=50
HYPERV_NETWORK_SWITCH=DefaultSwitch
HYPERV_IMAGE_URL=https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img

# Kubernetes Config
# Control Plane Node Configuration
K8S_CP_HOSTNAME_PREFIX=k8s-ha-cp
K8S_CP_IP_START=192.168.1.101
K8S_CP_IP_END=192.168.1.102
K8S_CP_IP_CIDR=24 # Subnet mask for control plane network
K8S_VERSION=v1.35.0
K8S_POD_CIDR=10.244.0.0/16
K8S_SERVICE_CIDR=10.96.0.0/12

# Virtual IP Configuration for HA Control Plane (kube-vip)
K8S_VIP_DOMAIN=dev.homelab.com
K8S_VIP=192.168.1.100  # Virtual IP for control plane
K8S_VIP_INTERFACE=eth0 # Primary network interface (auto-detect: leave empty)
K8S_VIP_ARP_ENABLED=true
K8S_VIP_LEADER_ELECTION=true

# MetalLB Load Balancer Configuration
K8S_METALLB_ENABLED=true
K8S_METALLB_IP_RANGE_START=192.168.1.105
K8S_METALLB_IP_RANGE_END=192.168.1.110
K8S_METALLB_ADDRESS_POOL_NAME=default-pool

# GitOps / Kubara-like Config
GITOPS_REPO_URL=git@github.com:org/platform-gitops.git
GITOPS_BRANCH=main
ARGOCD_PROJECT_PREFIX=ha-cluster-dev

# Stack Metadata
PULUMI_STACK=dev
PULUMI_BACKEND=local

# SSH Configuration (untuk remote command execution)
SSH_USER=ubuntu
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa